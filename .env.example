# =============================================================================
# NeMo Curator Environment Configuration
# =============================================================================
# fill in your credentials
# 
# IMPORTANT: Never commit your .env file to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# AWS Credentials (Required for Common Crawl and S3 access)
# -----------------------------------------------------------------------------
# Get these from AWS IAM Console: https://console.aws.amazon.com/iam/
# Required permissions: S3 read access for Common Crawl bucket

AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_DEFAULT_REGION=us-east-1

# -----------------------------------------------------------------------------
# HuggingFace Configuration (Optional)
# -----------------------------------------------------------------------------
# Required for private datasets or higher rate limits
# Get token from: https://huggingface.co/settings/tokens

HF_TOKEN=your_huggingface_token_here

# -----------------------------------------------------------------------------
# Ray Configuration (Optional)
# -----------------------------------------------------------------------------
# Configure Ray cluster settings for distributed processing

# RAY_ADDRESS=auto
# RAY_NUM_CPUS=8
# RAY_NUM_GPUS=1

# -----------------------------------------------------------------------------
# Logging Configuration (Optional)
# -----------------------------------------------------------------------------
# LOG_LEVEL=INFO
# LOG_FILE=./logs/preprocess.log
